# RehearseAI configuration. Copy to .env and adjust for your hardware.
# Run `python scripts/setup_check.py` for recommendations for this machine.

# --- LLM (Ollama) ---
LLM_MODEL=qwen2.5:7b
LLM_NUM_CTX=8192
# Can point to another machine on the local network, e.g. http://192.168.1.20:11434
OLLAMA_HOST=http://localhost:11434
# How long Ollama keeps the model loaded between requests
LLM_KEEP_ALIVE=30m
LLM_TEMPERATURE=0.2

# --- CV Builder LLM ---
# The CV Builder (Assignment 1 core) keeps its own model: its prompts and token budgets were
# tuned for gpt-oss:20b. It shares OLLAMA_HOST above. gpt-oss:20b and LLM_MODEL take turns in
# VRAM on most GPUs; a long LLM_KEEP_ALIVE keeps the interview model loaded, so switching
# between building a CV and practising can take a few seconds while Ollama swaps them.
# local | groq
CV_BUILDER_LLM_BACKEND=local
# Ollama model name, used when CV_BUILDER_LLM_BACKEND=local
CV_BUILDER_LLM_MODEL=gpt-oss:20b
# Ollama context window for the CV Builder. Its system prompts are ~4k tokens, so Ollama's
# default (4096) returns empty replies; lower this only if 16384 doesn't fit your GPU.
LOCAL_LLM_NUM_CTX=16384
# Optional cloud fallback: set CV_BUILDER_LLM_BACKEND=groq and add a key. Never commit it.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- Transcription ---
# faster-whisper | whisper-cpp | mlx
WHISPER_BACKEND=faster-whisper
# small | medium | large-v3-turbo
WHISPER_MODEL_SIZE=large-v3-turbo
# cuda | cpu   (ignored by mlx)
WHISPER_DEVICE=cuda
# float16 | int8
WHISPER_COMPUTE_TYPE=float16
# Language of spoken answers (ISO code). Fixing it is faster and more accurate than auto-detect.
WHISPER_LANGUAGE=en

# --- Privacy ---
# Sessions (CV, audio, transcripts, feedback) and CV Builder builds (profile, conversation,
# generated CV and PDF) older than this are deleted
AUDIO_RETENTION_DAYS=7
